# Google Gemini Developer API (AI Studio) — free tier is enough for this project.
# Get a key at https://aistudio.google.com/apikey
# Leave empty to run Renewal Radar in manual-entry-only mode.
GEMINI_API_KEY=

# Flash model id from the Gemini Developer API, e.g. gemini-3.5-flash.
# Never hardcode the model anywhere else — this variable is the single source of truth.
GEMINI_MODEL=

# Seconds to wait for the AI provider before giving up and offering manual entry.
AI_TIMEOUT_SECONDS=45

# Max characters of document text sent to the AI provider.
MAX_DOCUMENT_CHARS=60000

# SQLite database location.
DATABASE_PATH=./data/renewal_radar.db
